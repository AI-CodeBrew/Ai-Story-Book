# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=8080

# MongoDB Atlas
MONGODB_URI=your_mongodb_connection_string
MONGODB_DB_NAME=ai_storybook

# Auth (shared secret for both admin and user JWTs)
JWT_SECRET=a_long_random_secret

# Google Sign-In (Web application OAuth client ID, from Google Cloud Console;
# the same client ID is reused as the audience for web + Flutter Google tokens)
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id

# Bunny Storage (CDN-backed image storage for generated story pages)
BUNNY_STORAGE_ZONE=your_bunny_storage_zone
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
BUNNY_STORAGE_ACCESS_KEY=your_bunny_storage_access_key
BUNNY_PULL_ZONE_HOSTNAME=your_bunny_pull_zone_hostname
